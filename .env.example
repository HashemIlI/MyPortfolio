# Database
# Required in production.
# Prefer a non-SRV Atlas seed-list URI if local DNS has trouble with mongodb+srv.
# On Vercel, set the same variable in Project Settings -> Environment Variables.
MONGODB_URI=mongodb://<username>:<password>@<host-1>:27017,<host-2>:27017,<host-3>:27017/portfolio?ssl=true&replicaSet=<replica-set-name>&authSource=admin&retryWrites=true&w=majority&appName=portfolio-cms
# Atlas SRV alternative:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/portfolio?retryWrites=true&w=majority&appName=portfolio-cms
# Local fallback:
# MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Auth
# Required in production.
# Generate with: openssl rand -base64 32
JWT_SECRET=<replace-with-a-long-random-secret>
# Note: Admin credentials (username + password) are stored in the MongoDB
# AdminCredential collection, not in environment variables. Use the admin UI
# or run `npm run reset-password <username> <new-password>` to manage them.

# Public base URL — used for canonical URL, OG image, sitemap, and robots.txt.
# Set this in Vercel Project Settings → Environment Variables (Production scope).
# Fallback is the known production URL; set it to avoid stale fallbacks.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# GitHub Integration (optional)
GITHUB_TOKEN=
GITHUB_USERNAME=

# Vercel Blob (required for media uploads on Vercel)
# Set automatically when you link a Blob store in Vercel Project Settings.
BLOB_READ_WRITE_TOKEN=

# Deployment note:
# On Vercel, local filesystem uploads under /public/uploads are not writable at runtime.
# Uploaded files go to Vercel Blob. The Media Library reads from Blob when VERCEL=1.
